    <string name="feature_flag_room_directory_search_title">"房间目录搜索"</string>
    <string name="feature_flag_room_directory_search_description">"允许用户在其主服务器中搜索公开房间"</string>
    <string name="feature_flag_show_blocked_users_details_title">"显示已屏蔽用户详情"</string>
    <string name="feature_flag_show_blocked_users_details_description">"在已屏蔽用户列表中显示已屏蔽用户的名称和头像"</string>
    <string name="feature_flag_sync_on_push_title">"收到推送时同步"</string>
